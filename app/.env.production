EXPO_PUBLIC_API_URL=https://site--gym-bro-annotation--sl97py5sfg7k.code.run

# Sem barra no fim de propósito: além do axios (que lida com baseURL), a API_URL entra em
# concatenação direta no refresh de token e no upload de imagens (`${API_URL}/api/...`), onde uma
# barra sobrando viraria `//api/...`.
#
# Carregado automaticamente quando o bundle roda com NODE_ENV=production — ou seja, no
# assembleRelease (o bundleCommand passa --dev false). O `.env` continua valendo pro debug.
# Ambos são gitignored.
