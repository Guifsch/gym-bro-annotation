PORT=4000

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/gym-bro

AUTH_ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
AUTH_REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d

EMAIL_CODE_PEPPER=replace-with-a-long-random-string

# 'resend' or 'gmail' — Resend's sandbox sender only delivers to the account owner's own
# address until a domain is verified there; Gmail SMTP works for any recipient in the
# meantime. Switch back to 'resend' once a domain is set up.
EMAIL_PROVIDER=resend

RESEND_API_KEY=
RESEND_FROM_EMAIL=Gym Bro <onboarding@resend.dev>

# Gmail SMTP fallback — GMAIL_APP_PASSWORD is a 16-char App Password (requires 2FA enabled
# on the Google account), not the account's normal login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Must be a specific origin (not '*') for the web app's httpOnly-cookie auth to work —
# the browser rejects credentialed requests against a wildcard CORS origin.
CORS_ORIGIN=http://localhost:5173

# 'true' in production over HTTPS; 'false' (default) for local dev over plain HTTP.
AUTH_COOKIE_SECURE=false

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=https://pub-xxxxxxxx.r2.dev
